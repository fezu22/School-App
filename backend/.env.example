PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-development-secret

# API database URI: use a disposable development database, never production.
MONGODB_URI=mongodb://127.0.0.1:27017/school_platform_demo

# Seeder/reset scripts ONLY read this variable and require the database name to end in _demo.
DEMO_MONGODB_URI=mongodb://127.0.0.1:27017/school_platform_demo
ALLOW_DEMO_SEED=false

# Optional bootstrap administrator for a fresh development database only.
BOOTSTRAP_NAME=Development Administrator
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=replace-this-development-password
