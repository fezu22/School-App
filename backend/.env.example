# Required MongoDB configuration for database-backed operation.
# Never point development or test environments at production databases.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=greenwood_school_isolated

# Server port (defaults to 5000 in backend/src/server.js)
PORT=5000

# Unified Express router bridging JS (Student/Parent/Finance) and TS (Super Admin/Principal/Teacher) backends.
INTEGRATED_STAFF_ENABLED=true

# Optional: Standalone staff JWT authentication secret (>= 32 chars).
# Only required when running standalone staff JWT mode (INTEGRATED_STAFF_ENABLED !== "true").
# JWT_SECRET=

# Optional: Controlled first Ultra Admin setup secret (>= 32 chars, passed via X-Platform-Bootstrap-Secret header).
# Leave unset to keep Ultra Admin bootstrap disabled.
# PLATFORM_ULTRA_ADMIN_BOOTSTRAP_SECRET=

# Optional: Legacy single-school Super Admin bootstrap secret (>= 32 chars, passed via X-Bootstrap-Secret header).
# Leave unset to keep legacy Super Admin bootstrap disabled.
# SUPER_ADMIN_BOOTSTRAP_SECRET=

# Optional: Online card & mobile-money payment gateway configuration.
# Leave ONLINE_PAYMENTS_VERIFIED=false and secrets unset to keep online payments disabled.
ONLINE_PAYMENTS_VERIFIED=false
# CARD_PROVIDER_WEBHOOK_SECRET=

# Optional: ZEGO Cloud Live Classes configuration.
# Leave LIVE_LESSON_ENABLED=false / LIVE_LESSONS_VERIFIED=false and secrets unset to keep live streaming disabled.
LIVE_LESSON_ENABLED=false
LIVE_LESSONS_VERIFIED=false
ZEGOCLOUD_ROOM_PRIVILEGES_ENABLED=false
# ZEGOCLOUD_APP_ID=
# ZEGOCLOUD_SERVER_SECRET=
# LIVE_LESSON_TOKEN_TTL_SECONDS=300

# Optional: Server-side Gemini AI draft generation for recorded lessons.
# Leave RECORDED_LESSONS_AI_ENABLED=false or GEMINI_API_KEY unset to disable AI draft generation.
RECORDED_LESSONS_AI_ENABLED=false
# GEMINI_API_KEY=
