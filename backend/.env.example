PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=1d

# Disabled when empty. Set a server-only random secret of at least 32 characters
# during initial setup; send it via X-Bootstrap-Secret over HTTPS, then unset it.
# Never expose this value to frontend builds or request/access logs.
SUPER_ADMIN_BOOTSTRAP_SECRET=

# Server-only JSON, keyed by reviewer user ID. Each grant must contain branchId,
# types (approval category list), and financial grants additionally need limits.
# Empty/unconfigured grants deny access; no business money thresholds are supplied.
PRINCIPAL_APPROVAL_AUTHORITY={}
# Live Lessons: optional, validated only when issuing RTC credentials.
LIVE_LESSON_ENABLED=false
ZEGOCLOUD_APP_ID=
ZEGOCLOUD_SERVER_SECRET=
# Set true ONLY after enabling room login/publish privilege validation in ZEGO.
ZEGOCLOUD_ROOM_PRIVILEGES_ENABLED=false
LIVE_LESSON_TOKEN_TTL_SECONDS=300
