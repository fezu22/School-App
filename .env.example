# GEMINI_API_KEY: Optional server-side Gemini AI key for recorded-lesson draft summary, quiz, and revision generation.
# Leave commented out when AI draft generation is not used.
# GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (3000 in web/preview, 5000 for standalone native backend).
PORT="3000"

# MONGODB_URI & MONGODB_DB: Isolated MongoDB connection string and database name.
# Never point development/test environments at production databases.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="greenwood_school_isolated"

# INTEGRATED_STAFF_ENABLED: Optional flag for unified Express router (automatically set by start:integrated).
# INTEGRATED_STAFF_ENABLED="true"

# PLATFORM_ULTRA_ADMIN_BOOTSTRAP_SECRET: Optional >= 32-char secret for controlled first Ultra Admin setup.
# Leave unset to keep Ultra Admin bootstrap disabled.
# PLATFORM_ULTRA_ADMIN_BOOTSTRAP_SECRET=

# SUPER_ADMIN_BOOTSTRAP_SECRET: Optional >= 32-char secret for legacy single-school Super Admin bootstrap.
# Leave unset to keep legacy Super Admin bootstrap disabled.
# SUPER_ADMIN_BOOTSTRAP_SECRET=

# JWT_SECRET: Optional >= 32-char secret for standalone staff JWT token signing.
# Only required when running standalone staff JWT mode.
# JWT_SECRET=

# ONLINE_PAYMENTS_VERIFIED: Set to "true" ONLY when per-school hosted card/merchant credentials and webhook secrets are configured.
ONLINE_PAYMENTS_VERIFIED="false"
# CARD_PROVIDER_WEBHOOK_SECRET=

# LIVE_LESSON_ENABLED / LIVE_LESSONS_VERIFIED: Set to "true" ONLY when ZEGOCLOUD AppID, 32-byte ASCII ServerSecret,
# and room privilege enforcement (ZEGOCLOUD_ROOM_PRIVILEGES_ENABLED="true") are configured on the backend.
LIVE_LESSON_ENABLED="false"
LIVE_LESSONS_VERIFIED="false"
ZEGOCLOUD_ROOM_PRIVILEGES_ENABLED="false"
# ZEGOCLOUD_APP_ID=
# ZEGOCLOUD_SERVER_SECRET=
# LIVE_LESSON_TOKEN_TTL_SECONDS="300"

# RECORDED_LESSONS_AI_ENABLED: Optional server-side AI draft generation toggle for recorded lessons.
RECORDED_LESSONS_AI_ENABLED="false"
